+	-- CHANGED (Phase 2a remodel): the remodelled parts use tilted primitives (staves, struts, ribs); every one's
+	-- oriented bounding box must stay inside the part's cell so neighbouring blocks never overlap.
+	t.test("every primitive stays inside its part's box", function()
+		for _, def in Parts.List do
+			for _, mode in { "Real", "Cosmetic" } do
+				local model = PartVisuals.build(def, mode :: PartVisuals.Mode)
+				local bounds = model.PrimaryPart :: BasePart
+				t.expectEqual(bounds.Size, def.Size * CraftDesign.GRID)
+				local limit = bounds.Size / 2 + Vector3.new(BOUNDS_TOLERANCE, BOUNDS_TOLERANCE, BOUNDS_TOLERANCE)
+				for _, descendant in model:GetDescendants() do
+					if descendant:IsA("BasePart") then
+						local cf, half = descendant.CFrame, descendant.Size / 2
+						local right, up, back = cf.RightVector, cf.UpVector, cf.LookVector
+						local extent = Vector3.new(
+							math.abs(right.X) * half.X + math.abs(up.X) * half.Y + math.abs(back.X) * half.Z,
+							math.abs(right.Y) * half.X + math.abs(up.Y) * half.Y + math.abs(back.Y) * half.Z,
+							math.abs(right.Z) * half.X + math.abs(up.Z) * half.Y + math.abs(back.Z) * half.Z
+						)
+						local p = cf.Position
+						local inside = math.abs(p.X) + extent.X <= limit.X
+							and math.abs(p.Y) + extent.Y <= limit.Y
+							and math.abs(p.Z) + extent.Z <= limit.Z
+						t.expectTrue(inside, `{def.Id} {mode} {descendant.Name} leaves the part box`)
+						t.expectTrue(descendant.Anchored, `{def.Id} {mode} {descendant.Name} is anchored`)
+					end
+				end
+				model:Destroy()
+			end
+		end
+	end)
+

+	local sw, st = CHUTE_STRAP_SIZE.X, CHUTE_STRAP_SIZE.Y
+	for i = 1, CHUTE_STRAPS do
+		local a = (i - 1) / CHUTE_STRAPS * TAU + math.pi / CHUTE_STRAPS
+		local u = radial(a)
+		local function point(s: number): Vector3
+			return u * (domeR(s) + st / 2) + Vector3.new(0, canTop + domeH * s, 0)
+		end
+		for j = 1, CHUTE_STRAP_SEGMENTS do

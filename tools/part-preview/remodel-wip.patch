+-- Bell wall radius at t (0 throat .. 1 exit): a quadratic flare down to BELL_SPLIT that meets a straight skirt
+-- tangentially; the throat slope is BELL_FLARE times the skirt slope.
+local function bellRadius(t: number, rThroat: number, rExit: number): number
+	local ts, f = BELL_SPLIT, BELL_FLARE
+	local m = (rExit - rThroat) / (1 - ts + (1 + f) / 2 * ts) -- skirt slope
+	local rise = (1 + f) / 2 * m * ts -- radius gained over the curved part
+	if t >= ts then
+		return rThroat + rise + m * (t - ts)
+	end
+	local k = (m * ts - rise) / (ts * ts)
+	local c = m - 2 * k * ts
+	return rThroat + c * t + k * t * t
+end

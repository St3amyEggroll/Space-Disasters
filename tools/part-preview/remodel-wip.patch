+	local domeTop = S.Y * CHUTE_DOME_TOP
+	local domeH = domeTop - canTop
+	local stop = CHUTE_DOME_END
+	local function domeR(s: number): number -- s is the height fraction of the full ellipse
+		return R * math.sqrt(math.max(1 - s * s, 0))
+	end
+	lathe(ctx, "Canopy", CHUTE_DOME_SLICES, canTop - LATHE_OVERLAP, canTop + domeH * stop, function(t: number): number
+		return domeR(t * stop)

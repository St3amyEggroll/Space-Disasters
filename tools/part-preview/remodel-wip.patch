+			`Buckle{i}`,
+			buckle,
+			CFrame.fromMatrix(u * (canD / 2 + buckle.Z / 2 - 0.02) + Vector3.new(0, canTop - bandH / 2, 0), tangential(a), Y_AXIS),
+			LOOK.Metal,
+			true
+		)
+	end

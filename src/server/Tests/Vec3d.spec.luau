--!strict
-- Tests for Shared/Math/Vec3d.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TestKit = require(script.Parent.TestKit)
local Vec3d = require(ReplicatedStorage.Shared.Math.Vec3d)

return function(t: TestKit.Context)
	t.test("add / sub / scale", function()
		local a = Vec3d.new(1, 2, 3)
		local b = Vec3d.new(-4, 5.5, 10)
		local s = Vec3d.add(a, b)
		t.expectEqual(s.x, -3)
		t.expectEqual(s.y, 7.5)
		t.expectEqual(s.z, 13)
		local d = Vec3d.sub(a, b)
		t.expectEqual(d.x, 5)
		t.expectEqual(d.y, -3.5)
		t.expectEqual(d.z, -7)
		local k = Vec3d.scale(a, -2)
		t.expectEqual(k.z, -6)
		local as = Vec3d.addScaled(a, b, 2)
		t.expectEqual(as.x, -7)
	end)

	t.test("into variants allow aliasing", function()
		local a = Vec3d.new(1, 2, 3)
		Vec3d.addInto(a, a, a)
		t.expectEqual(a.x, 2)
		t.expectEqual(a.z, 6)
		local c = Vec3d.new(1, 0, 0)
		Vec3d.crossInto(c, c, Vec3d.new(0, 1, 0))
		t.expectEqual(c.x, 0)
		t.expectEqual(c.y, 0)
		t.expectEqual(c.z, 1)
	end)

	t.test("dot / cross / length / normalize", function()
		local x = Vec3d.new(1, 0, 0)
		local y = Vec3d.new(0, 1, 0)
		local z = Vec3d.cross(x, y)
		t.expectEqual(z.z, 1)
		t.expectEqual(Vec3d.dot(x, y), 0)
		t.expectNear(Vec3d.length(Vec3d.new(3, 4, 12)), 13, 1e-12)
		local n = Vec3d.normalize(Vec3d.new(0, 0, -7))
		t.expectNear(n.z, -1, 1e-15)
		local zero = Vec3d.normalize(Vec3d.zero())
		t.expectEqual(Vec3d.length(zero), 0)
		t.expectNear(Vec3d.angle(x, y), math.pi / 2, 1e-12)
	end)

	t.test("doubles keep millimeters at interplanetary distances (I1)", function()
		-- 1e11 m is the far end of the scaled-space mapping: doubles resolve ~1.5e-5 m there, floats only ~8 km
		local far = Vec3d.new(1e11 + 0.001, -2e10, 5e10)
		local ref = Vec3d.new(1e11, -2e10, 5e10)
		local delta = Vec3d.sub(far, ref)
		t.expectNear(delta.x, 0.001, 1e-4)
		local v = Vec3d.toVector3(delta)
		t.expectNear(v.X, delta.x, 1e-9) -- the small delta survives float conversion
	end)

	t.test("rotate / invRotate round trip", function()
		local rot = CFrame.Angles(0.3, -1.1, 2.4)
		local v = Vec3d.new(123456.789, -98765.4321, 5555.5)
		local r = Vec3d.rotate(rot, v)
		local back = Vec3d.invRotate(rot, r)
		t.expectNear(back.x, v.x, 1e-6 * 123456)
		t.expectNear(back.y, v.y, 1e-6 * 123456)
		t.expectNear(back.z, v.z, 1e-6 * 123456)
		-- matches Roblox's own rotation for small vectors
		local small = Vec3d.new(1, 2, 3)
		local mine = Vec3d.rotate(rot, small)
		local theirs = rot:VectorToWorldSpace(Vector3.new(1, 2, 3))
		t.expectNear(mine.x, theirs.X, 1e-5)
		t.expectNear(mine.y, theirs.Y, 1e-5)
		t.expectNear(mine.z, theirs.Z, 1e-5)
	end)

	t.test("isFinite rejects NaN and inf", function()
		t.expectTrue(Vec3d.isFinite(Vec3d.new(1, 2, 3)))
		t.expectTrue(not Vec3d.isFinite(Vec3d.new(0 / 0, 0, 0)))
		t.expectTrue(not Vec3d.isFinite(Vec3d.new(math.huge, 0, 0)))
	end)
end
